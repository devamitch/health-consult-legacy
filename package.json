{
  "name": "health-consult-legacy",
  "version": "1.0.8",
  "private": true,
  "scripts": {
    "start": "react-native start --reset-cache",
    "ios:simulator": "react-native run-ios  --simulator 'iPhone 16 Pro Max'",
    "ios": "react-native run-ios --device ",
    "ios:release": "react-native run-ios --device --mode Release",
    "ios:simulator:release": "react-native run-ios --simulator 'iPhone 16 Pro Max' --mode Release",
    "android:play": "react-native run-android --mode=googlePlayDebug",
    "android:play:apk": "react-native build-android --mode=googlePlayDebug",
    "android:amazon": "react-native run-android --mode=amazonDebug",
    "build:android:play": "react-native build-android --mode=googlePlayRelease",
    "build:android:amazon": "react-native build-android --mode=amazonRelease",
    "build:ios": "cd ios && xcodebuild -workspace HealthPulse.xcworkspace -scheme HealthPulse -configuration Release",
    "clean": "react-native-clean-project",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && rm -rf build",
    "clean:cache": "watchman watch-del-all && rm -rf $TMPDIR/react-* && rm -rf node_modules/.cache && yarn cache clean",
    "clean:modules": "rm -rf node_modules && yarn install",
    "clean:pods": "cd ios && rm -rf ~/Library/Caches/CocoaPods && rm -rf Pods && rm -rf ~/Library/Developer/Xcode/DerivedData/* && pod deintegrate",
    "reset": "yarn clean:cache && yarn clean:modules",
    "reset:ios": "yarn clean:pods && yarn pod:install",
    "reset:all": "yarn reset && yarn reset:ios && yarn clean:android",
    "pod:install": "cd ios && pod install",
    "pod:update": "cd ios && pod install --repo-update --verbose",
    "rename": "npx react-native-rename",
    "link": "npx react-native-asset",
    "doctor": "npx react-native doctor",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "patch": "npx patch-package",
    "release:bump": "npx react-native-version --never-amend",
    "analyze": "npx react-native-bundle-visualizer",
    "env:dev": "cp .env.development .env",
    "env:prod": "cp .env.production .env",
    "iap:validate": "node scripts/validate-iap-config.js",
    "debug:android": "adb shell input keyevent 82",
    "debug:ios": "xcrun simctl send booted shake",
    "deploy:android": "yarn build:android:play && open ./android/app/build/outputs/bundle/googlePlayRelease/",
    "deploy:ios": "cd ios && fastlane beta",
    "codepush:check": "appcenter codepush deployment list -a {USERNAME}/{APP_NAME} -k",
    "codepush:ios:staging": "appcenter codepush release-react -a {USERNAME}/MyApp-iOS -d Staging",
    "codepush:ios:prod": "appcenter codepush release-react -a {USERNAME}/MyApp-iOS -d Production",
    "codepush:android:staging": "appcenter codepush release-react -a {USERNAME}/MyApp-Android -d Staging",
    "codepush:android:prod": "appcenter codepush release-react -a {USERNAME}/MyApp-Android -d Production",
    "codepush:promote:ios": "appcenter codepush promote -a {USERNAME}/MyApp-iOS -s Staging -d Production",
    "codepush:promote:android": "appcenter codepush promote -a {USERNAME}/MyApp-Android -s Staging -d Production",
    "codepush:history:ios": "appcenter codepush deployment history -a {USERNAME}/MyApp-iOS Staging",
    "codepush:history:android": "appcenter codepush deployment history -a {USERNAME}/MyApp-Android Staging",
    "fastlane:ios:beta": "cd ios && bundle exec fastlane beta",
    "fastlane:ios:release": "cd ios && bundle exec fastlane release",
    "fastlane:android:beta": "cd android && bundle exec fastlane beta",
    "fastlane:android:release": "cd android && bundle exec fastlane release",
    "fastlane:ios:certificates": "cd ios && bundle exec fastlane sync_certificates",
    "fastlane:ios:build": "cd ios && bundle exec fastlane build",
    "deploy:ios:staging": "yarn fastlane:ios:beta && yarn codepush:ios:staging",
    "deploy:android:staging": "yarn fastlane:android:beta && yarn codepush:android:staging",
    "deploy:ios:prod": "yarn fastlane:ios:release && yarn codepush:ios:prod",
    "deploy:android:prod": "yarn fastlane:android:release && yarn codepush:android:prod",
    "deploy:staging": "yarn deploy:ios:staging && yarn deploy:android:staging",
    "deploy:prod": "yarn deploy:ios:prod && yarn deploy:android:prod",
    "promote:all": "yarn codepush:promote:ios && yarn codepush:promote:android",
    "setup:fastlane": "bundle install",
    "setup:codepush": "yarn global add appcenter-cli && appcenter login",
    "setup:all": "yarn setup:fastlane && yarn setup:codepush"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-firebase/app": "^23.1.2",
    "@react-native-firebase/auth": "^23.1.2",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@react-native/new-app-screen": "0.81.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.0",
    "@react-native/eslint-config": "0.81.0",
    "@react-native/metro-config": "0.81.0",
    "@react-native/typescript-config": "0.81.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4",
    "@types/react": "^19.1.0",
    "@types/react-native-check-box": "^2",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@4.9.4",
  "author": {
    "name": "Amit Chakraborty",
    "email": "amit98ch@gmail.com",
    "url": "https://github.com/devamitch"
  },
  "license": "MIT",
  "homepage": "https://github.com/devamitch/health-consult-legacy#readme"
}
